# Application key - will be generated in next steps
APP_KEY=SomeRandomString

# Development mode
APP_ENV=local
APP_DEBUG=true

# theme - must be "tinymist" to load Tinymist theme overrides (blade views, CSS, JS)
# Used by: BookStack core (app/Config/app.php → active theme)
APP_THEME=tinymist

# Local server URL (we'll use PHP's built-in server)
APP_URL=http://localhost:8000

# MariaDB Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bookstack_dev
DB_USERNAME=root
DB_PASSWORD=my-password

# Disable email requirements (logs emails to storage/logs instead)
MAIL_DRIVER=log
MAIL_FROM_NAME="BookStack Dev"
MAIL_FROM=dev@bookstack.local

# Easy local registration without email verification
ALLOW_PUBLIC_REGISTRATION=true

# Enable development tools
CLOCKWORK_ENABLE=true
DEBUGBAR_ENABLED=true

###############################################################################
# Tinymist Configuration
# Config file: app/Config/tinymist.php
# All env vars below map to config('tinymist.*') unless noted otherwise.
###############################################################################

# ── Feature Toggle ──────────────────────────────────────────────────────────
# Enable/disable the Tinymist (Typst) editor option in BookStack.
# Values: true | false   Default: true
# Used by: app/Config/tinymist.php → 'enabled'
# Read in: TinymistEditorToolboxComposer, TinymistController::status(), PageEditorData
TINYMIST_ENABLED=true

# ── CLI Paths ───────────────────────────────────────────────────────────────
# Path to the typst CLI executable. Can be absolute, relative to project root,
# a directory (binary name auto-appended), or bare command name found via PATH.
# Default: vendor/bin/typst[.exe]
# Used by: app/Config/tinymist.php → 'typst_cli_path'
# Read in: TinymistService (PHP-side compilation + PDF export)
TYPST_CLI_PATH=vendor/bin

# Path to the tinymist CLI executable (LSP server binary).
# Same resolution rules as TYPST_CLI_PATH.
# Default: vendor/bin/tinymist[.exe]
# Used by: app/Config/tinymist.php → 'tinymist_cli_path'
# Read in: tinymist-devops/node/shared/path-config.ts → getTinymistCliPath()
#          tinymist-devops/node/file-sync/lsp-client.ts → getTinymistCommand()
#          tinymist-devops/node/preview/preview-server.ts (spawns preview processes)
TINYMIST_CLI_PATH=vendor/bin

# Path to the pandoc CLI executable (document conversion: HTML↔Typst).
# Default: vendor/bin/pandoc[.exe]
# Used by: app/Config/tinymist.php → 'pandoc_cli_path'
# Read in: TinymistPandocService
PANDOC_CLI_PATH=vendor/bin

# ── Compilation ─────────────────────────────────────────────────────────────
# Maximum seconds for typst CLI compilation before timeout.
# Default: 30
# Used by: app/Config/tinymist.php → 'timeout'
# Read in: TinymistService, TinymistPandocService
TINYMIST_TIMEOUT=30

# Timeout (seconds) for AJAX fallback compile endpoint (/ajax/tinymist/compile).
# Default: 30
# Used by: app/Config/tinymist.php → 'ajax_timeout'
TINYMIST_AJAX_TIMEOUT=30

# Maximum Typst document size in KB before rejection.
# Default: 1024
# Used by: app/Config/tinymist.php → 'max_document_size'
# Read in: TinymistController::compile(), TinymistController::convertToTypst()
TINYMIST_MAX_SIZE=1024

# ── WebSocket Authentication ────────────────────────────────────────────────
# Shared HMAC secret for signing JWT tokens that authenticate browser ↔ Node WS.
# Generate with: openssl rand -hex 32
# Used by: app/Config/tinymist.php → 'ws_token_secret'
# Read in: TinymistPreviewManager (PHP mints token)
#          tinymist-devops/node/token-helper.ts (Node verifies token)
TINYMIST_WS_SECRET=<random 64-hex string>

# Token time-to-live in seconds. Browser auto-renews via /ajax/tinymist/renew-ws-token.
# Default: 1800 (PHP config) / 900 (previous .env default)
# Used by: app/Config/tinymist.php → 'ws_token_ttl'
# Read in: TinymistPreviewManager
TINYMIST_WS_TOKEN_TTL=900

# ── File Sync WebSocket Server ──────────────────────────────────────────────
# Host and port for the Node file-sync + LSP bridge WS server.
# Browser connects via /ws/tinymist/file-sync/ (nginx reverse-proxied).
# Used by: tinymist-devops/node/file-sync/server.ts
FILE_WS_HOST=127.0.0.1
FILE_WS_PORT=2000

# Override the root directory for Typst document storage.
# Default: <project>/storage/app/tinymist
# Used by: tinymist-devops/node/file-sync/server.ts → STORAGE_ROOT
# TYPST_STORAGE_ROOT=

# ── Preview Bridge WebSocket Server ────────────────────────────────────────
# Host/port the Node preview bridge WS server listens on.
# Browser connects via /ws/tinymist/preview/ (nginx reverse-proxied).
# Used by: tinymist-devops/node/preview/preview-server.ts
TINYMIST_PREVIEW_BRIDGE_HOST=127.0.0.1
TINYMIST_PREVIEW_BRIDGE_PORT=2020

# Host for tinymist preview child processes (localhost connections only).
# Default: 127.0.0.1
# Used by: tinymist-devops/node/preview/preview-server.ts → PREVIEW_HOST
TINYMIST_PREVIEW_HOST=127.0.0.1

# Base port for tinymist preview control-plane WebSocket.
# Each page gets: control_port = base + (2 * page_id), data_port = base + (2 * page_id) + 1
# Default: 33626
# Used by: tinymist-devops/node/preview/preview-server.ts → CONTROL_BASE_PORT
TINYMIST_CONTROL_BASE_PORT=13626

# Maximum concurrent preview server instances.
# Default: 20
# Used by: tinymist-devops/node/preview/preview-server.ts → MAX_PREVIEW_SERVERS
TINYMIST_MAX_PREVIEW_SERVERS=20

# Minutes of inactivity before a preview server is auto-terminated.
# 0 = never auto-terminate.
# Default: 5 (Node) / 30 (PHP config)
# Used by: tinymist-devops/node/preview/preview-server.ts → IDLE_TIMEOUT_MINUTES
TINYMIST_PREVIEW_IDLE_TIMEOUT=5

# Milliseconds to wait for a preview session to become ready after spawn.
# Default: 30000
# Used by: tinymist-devops/node/preview/preview-server.ts → SESSION_READY_TIMEOUT_MS
TINYMIST_PREVIEW_READY_TIMEOUT=30000

# Interval (ms) for WebSocket ping/keepalive in preview bridge.
# Default: 20000
# Used by: tinymist-devops/node/preview/preview-server.ts → PING_INTERVAL_MS
TINYMIST_BRIDGE_PING_INTERVAL=20000

# Enable partial (incremental) rendering in tinymist preview.
# Default: true (disabled only when set to literal "false")
# Used by: tinymist-devops/node/preview/preview-server.ts → PARTIAL_RENDERING
TINYMIST_PARTIAL_RENDERING=true

# Timeout (ms) for orphan-cleanup OS commands (wmic / pgrep).
# Default: 8000
# Used by: tinymist-devops/node/preview/preview-server.ts → CLEANUP_COMMAND_TIMEOUT_MS
TINYMIST_PREVIEW_CLEANUP_TIMEOUT=8000

# Override the allowed WebSocket origin for tinymist preview connections.
# Default: auto-built from TINYMIST_PREVIEW_BRIDGE_HOST:PORT
# Used by: tinymist-devops/node/preview/preview-server.ts → websocketOrigin
# TINYMIST_PREVIEW_ORIGIN=

# ── Typst Packages ─────────────────────────────────────────────────────────
# Directory containing locally-installed Typst packages.
# Relative to project root (or absolute). Resolved by both PHP and Node.
# Default: storage/app/tinymist/packages
# Used by: app/Config/tinymist.php → 'package_path'
#          tinymist-devops/node/shared/path-config.ts → getTypstPackagePath()
TYPST_PACKAGE_PATH=storage/app/tinymist/packages

# Storage-relative path for installed packages (legacy alias).
# Default: tinymist/packages
# Used by: app/Config/tinymist.php → 'packages_storage_path'
# TINYMIST_PACKAGES_STORAGE_PATH=tinymist/packages

# Storage-relative path for the cloned GitHub typst/packages repository.
# Default: tinymist/github/packages
# Used by: app/Config/tinymist.php → 'github_packages_storage_path'
#          TinymistPackageService
# TINYMIST_GITHUB_PACKAGES_STORAGE_PATH=tinymist/github/packages

# Git URL for the upstream Typst packages registry.
# Default: https://github.com/typst/packages.git
# Used by: app/Config/tinymist.php → 'github_packages_repo'
# TINYMIST_GITHUB_PACKAGES_REPO=https://github.com/typst/packages.git

# Branch to track in the upstream packages repo.
# Default: main
# Used by: app/Config/tinymist.php → 'github_packages_branch'
# TINYMIST_GITHUB_PACKAGES_BRANCH=main

# ── Build / Install Scripts ─────────────────────────────────────────────────
# These env vars are read by tinymist-devops/download-*.js during `npm postinstall`.

# GitHub owner/repo for the patched tinymist binary release.
# Default: Dodotree/tinymist
# Used by: tinymist-devops/download-tinymist.js
# TINYMIST_RELEASE_REPO=Dodotree/tinymist

# Git tag / version to download.
# Default: 0.14.10
# Used by: tinymist-devops/download-tinymist.js
# TINYMIST_RELEASE_TAG=0.14.10

# GitHub owner/repo for pandoc releases.
# Default: jgm/pandoc
# Used by: tinymist-devops/download-pandoc.js
# PANDOC_RELEASE_REPO=jgm/pandoc

# Pandoc release tag to download ("latest" = resolve latest).
# Default: latest
# Used by: tinymist-devops/download-pandoc.js
# PANDOC_RELEASE_TAG=latest

# GitHub personal access token for download scripts (avoids rate limits).
# Used by: tinymist-devops/download-pandoc.js
# GITHUB_TOKEN=
# GH_TOKEN=

# ── Logging / Debug ─────────────────────────────────────────────────────────
# Log payload metadata for preview bridge debugging. 0 = off, 1 = on.
# (Currently only used in .env; no process.env reader found in code.)
TINYMIST_PREVIEW_LOG_PAYLOAD_META=1

# Rust log level for tinymist/typst child processes.
# Values: error | warn | info | debug | trace
# Inherited by tinymist preview processes via process.env passthrough.
RUST_LOG=info
